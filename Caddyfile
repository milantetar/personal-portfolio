{
    admin off
    frankenphp
    order php_server before file_server
}

:{$PORT:8080} {
    root * /app/public
    encode zstd gzip
    request_body {
        max_size 25MB
    }
    log {
        output stdout
        format json
    }
    header /build/assets/* Cache-Control "public, max-age=31536000, immutable"
    php_server
    file_server
}
