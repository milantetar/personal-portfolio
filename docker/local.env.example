# Copy to .env.docker in the project root. Never commit that private file.
# Generate APP_KEY using: php artisan key:generate --show
APP_NAME="Personal Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
INERTIA_SSR_ENABLED=false
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Isolated Docker volume; your development database is not mounted.
DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/app/database/database.sqlite
DB_URL=
# To test Neon instead, use a dedicated test branch, set DB_CONNECTION=pgsql,
# clear DB_DATABASE, and paste its PostgreSQL connection string into DB_URL.
DB_SSLMODE=require
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=portfolio_docker_session
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com

# Fill these before starting. Bootstrap creates only missing admin/content.
SEED_ON_DEPLOY=true
ADMIN_NAME="Local Docker Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Obtain the key at https://aistudio.google.com/apikey (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen
GEMINI_TIMEOUT_SECONDS=12
PORTFOLIO_ASSISTANT_PER_MINUTE_LIMIT=10
PORTFOLIO_ASSISTANT_DAILY_LIMIT=60

# Set MEDIA_STORAGE_DISK=cloudinary and supply CLOUDINARY_URL to test uploads.
FILESYSTEM_DISK=local
MEDIA_STORAGE_DISK=public
CLOUDINARY_URL=
CLOUDINARY_FOLDER=personal-portfolio-local
GITHUB_USERNAME=
GITHUB_TOKEN=
