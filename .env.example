APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Leave empty for direct access; set verified proxy IPs/CIDRs behind an ingress.
TRUSTED_PROXIES=
INERTIA_SSR_ENABLED=false
SEED_ON_DEPLOY=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_STORAGE_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=re_your_api_key

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set MEDIA_STORAGE_DISK=cloudinary in production and provide CLOUDINARY_URL
# from your hosting provider's secret/environment settings.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=personal-portfolio

VITE_APP_NAME="${APP_NAME}"

# Optional: GitHub projects integration.
# GITHUB_TOKEN is recommended to increase GitHub API rate limits from 60 to 5,000 req/hr.
GITHUB_TOKEN=
GITHUB_USERNAME=your_github_username
# Only needed on local Windows environments if cURL throws SSL error 60 (use forward slashes: "C:/path/to/cacert.pem"); leave blank in production.
GITHUB_CA_BUNDLE=

# Optional: Google Gemini AI assistant for the public portfolio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen
GEMINI_TIMEOUT_SECONDS=12
# Only needed on local Windows environments if cURL throws SSL error 60 (use forward slashes: "C:/path/to/cacert.pem"); leave blank in production.
GEMINI_CA_BUNDLE=
PORTFOLIO_ASSISTANT_PER_MINUTE_LIMIT=10
PORTFOLIO_ASSISTANT_DAILY_LIMIT=60

# Initial administrator account created when running: php artisan db:seed
ADMIN_NAME="Portfolio Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
