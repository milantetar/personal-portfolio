            {
                "id": 1,
                "slug": "hero",
                "type": "hero",
                "title": "I build Backend APIs and backend features.",
                "eyebrow": "Junior Backend Developer | PHP & Laravel API Engineer",
                "content": "{\"description\": \"Backend developer with 9 months of professional experience at Netclues Technologies (November 2025–August 2026). I built Laravel REST APIs and database-backed features using MVC, Eloquent ORM, MySQL, authentication, request validation, middleware, and API Resources. Open to PHP and Laravel backend roles.\", \"primary_cta_url\": \"#projects\", \"primary_cta_label\": \"View My Work\", \"secondary_cta_url\": \"https://drive.google.com/drive/folders/1RwH-tK6QgZEXSdTJmO1AVGuXomTeb5Qm?usp=drive_link\", \"secondary_cta_label\": \"Download CV\"}",
                "sort_order": 1,
                "is_visible": 1
            },
            {
                "id": 2,
                "slug": "about",
                "type": "about",
                "title": "About Milan",
                "eyebrow": "#about",
                "content": "{\"description\": \"I’m Milan Tetar, a backend developer based in Rajkot, Gujarat. I spent nine months at Netclues Technologies in Ahmedabad, progressing from PHP Trainee to Jr. Software Engineer. I build Laravel REST APIs and database-backed features with MVC, Eloquent, MySQL, validation, middleware, and API Resources. I completed a B.Tech in Computer Engineering at Marwadi University and also build interfaces with React and TypeScript. I’m available to join immediately and open to onsite, hybrid, or remote PHP/Laravel roles.\"}",
                "sort_order": 2,
                "is_visible": 1
            },
            {
                "id": 3,
                "slug": "skills",
                "type": "skills",
                "title": "Technical skills",
                "eyebrow": "#skills",
                "content": "{\"body\": \"Backend\\nLaravel\\nPHP\\nSpring Boot\\nREST APIs\\nLaravel MVC\\nEloquent ORM\\nAuthentication\\nRequest validation\\nMiddleware\\nAPI Resources\\n\\nDatabases\\nMySQL\\nPostgreSQL\\nSQLite\\nSupabase\\n\\nFrontend\\nReact\\nHTML\\nCSS\\njQuery\\nTypeScript\\nJavaScript\\n\\nProgramming languages\\nJava\\nPHP\\nPython\\nTypeScript\\nJavaScript\\n\\nTools and cloud\\nGit\\nGitHub\\nAWS\\nVercel\\nLinux\\nWindows\"}",
                "sort_order": 3,
                "is_visible": 1
            },
            {
                "id": 4,
                "slug": "experience",
                "type": "experience",
                "title": "Professional experience",
                "eyebrow": "#experience",
                "content": "{\"body\": \"Jr. Software Engineer — PHP / Laravel Backend | Netclues Technologies Pvt. Ltd., Ahmedabad | June 2026–August 2026\\nDeveloped and maintained Laravel REST APIs with API Resources for consistent JSON responses.\\nBuilt MVC backend modules with CRUD operations, Eloquent models, relationships, and MySQL.\\nImplemented authentication, request validation, and middleware to secure endpoints and protect data integrity.\\nWorked to team coding standards, used Git for version control, and collaborated on feature delivery.\\nDebugged backend issues and improved the reliability of API endpoints and database queries.\\nPHP Trainee | Netclues Technologies Pvt. Ltd., Ahmedabad | November 2025–May 2026\\nCompleted structured training in PHP, Laravel, and MySQL while contributing to project work with senior developer guidance.\\nBuilt CRUD features and database migrations; practiced validation, routing, and error handling.\\nPromoted to Jr. Software Engineer after demonstrating readiness to take ownership of backend modules.\"}",
                "sort_order": 4,
                "is_visible": 1
            },
